# Euri API — used for GPT-4o explanations via api.euron.one
EURI_API_KEY=your_euri_api_key_here

# Telegram — bot token from @BotFather, chat_id is your channel/group/user ID
TELEGRAM_BOT_TOKEN=123456789:ABC-...
TELEGRAM_CHAT_ID=-1001234567890

# Supabase — project URL and anon/service-role key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=eyJ...
